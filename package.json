{
  "name": "arbiterOS-legal-confidant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Contract-first legal confidant. Archer meets Goliath. Contracts > Prompts.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch backend/server.ts",
    "seed:admin": "tsx backend/scripts/seedAdmin.ts",
    "bootstrap:common-law": "tsx backend/scripts/bootstrapCommonLaw.ts",
    "bootstrap:caslaw-drive": "tsx bootstrap-caslaw-drive.ts",
    "test:unit": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.9.0",
    "parquetjs-lite": "^0.8.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.0",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.3",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.15"
  }
