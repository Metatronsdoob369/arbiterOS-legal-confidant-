{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://book-pipeline/register-lexicon",
  "title": "Register Lexicon",
  "description": "Bilingual commercial register pack: plain English surface forms mapped to institutional/statutory senses with epistemic banding. Sibling to Book DNA — senses, not style fingerprints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lexicon_id", "version", "entries"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "lexicon_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/RegisterEntry" }
    }
  },
  "$defs": {
    "RegisterSense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "epistemic", "definition", "authority_cite"],
      "properties": {
        "register": {
          "type": "string",
          "enum": ["plain", "institutional", "statute", "fiscal", "capacity", "contested"]
        },
        "epistemic": {
          "type": "string",
          "enum": ["settled", "institutional", "plain", "contested"],
          "description": "settled = code/manual doctrine; institutional = agency/bank practice; plain = everyday usage; contested = live definitional zone (not advocacy myth)."
        },
        "definition": { "type": "string", "minLength": 1 },
        "authority_cite": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "RegisterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_id", "surface_forms", "senses", "mirror_hint"],
      "properties": {
        "term_id": { "type": "string", "minLength": 1 },
        "surface_forms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "matrix": {
          "type": "string",
          "enum": [
            "money_credit",
            "private_public_lien",
            "identity_split",
            "procedural",
            "discharge",
            "capacity",
            "fiscal"
          ]
        },
        "senses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RegisterSense" }
        },
        "confusion_with": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "mirror_hint": { "type": "string", "minLength": 1 },
        "procedural_triggers": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}
