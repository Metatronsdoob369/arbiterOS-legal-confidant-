# ArbiterOS — Environment Variables
# Copy to .env, source it in your shell, and never commit the result.

# Backend defaults for the local airgapped MVP
ARBITER_BACKEND_PORT=4881
ARBITER_DB_PATH=data/arbiter.db
ARBITER_SESSION_COOKIE=arbiter_session
ARBITER_SESSION_SECRET=replace-with-local-secret
ARBITER_BOOTSTRAP_USERNAME=admin
ARBITER_BOOTSTRAP_PASSWORD=secret-passphrase

# AI Provider (OpenAI-compatible — works with xAI, OpenRouter, Ollama, etc.)
VITE_API_KEY=your-api-key-here
VITE_AI_BASE_URL=https://api.openai.com/v1
VITE_AI_MODEL=gpt-4o
VITE_AI_CRITIC_MODEL=gpt-4o

# WhiteGlove Faith-Less Retrieval (optional — falls back to built-in library if not set)
VITE_WHITEGLOVE_URL=http://localhost:4880
